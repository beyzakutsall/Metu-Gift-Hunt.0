{
  "name": "@metu-gift-hunt/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "db:setup": "tsx src/setupDatabase.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "match:test": "tsx scripts/matchTest.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9"
  }
}

# Every value is optional in development.
NODE_ENV=development
PORT=4000
# Address to listen on. 0.0.0.0 on Render and other hosts with their own proxy.
HOST=127.0.0.1
# Without a user in the URL, your OS username is used.
DATABASE_URL=postgresql://localhost:5432/campus_quest
# Public URL of the frontend: used in email links and for the origin check.
# In production the API serves the frontend itself, so this is the API's own https:// address.
APP_URL=http://localhost:5173
# Email: BREVO_API_KEY (HTTPS, works where SMTP ports are blocked, e.g. Render free) wins over SMTP_URL.
# With neither, emails are printed in the API terminal. One of them is required in production.
BREVO_API_KEY=
SMTP_URL=
MAIL_FROM=METU Gift Hunt <no-reply@example.com>
# Number of reverse proxies in front of the API in production.
TRUST_PROXY=0

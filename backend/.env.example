# Every value is optional in development.
NODE_ENV=development
PORT=4000
# Without a user in the URL, your OS username is used.
DATABASE_URL=postgresql://localhost:5432/campus_quest
# Public URL of the frontend: used in email links and for the origin check.
APP_URL=http://localhost:5173
# Left empty, emails are printed in the API terminal. Required in production.
SMTP_URL=
MAIL_FROM=METU Gift Hunt <no-reply@example.com>
# Number of reverse proxies in front of the API in production.
TRUST_PROXY=0

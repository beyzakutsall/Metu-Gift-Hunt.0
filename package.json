{
  "name": "campus-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:mock": "npm run dev:mock -w frontend",
    "db:setup": "npm run db:setup -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w backend",
    "build": "npm run typecheck && npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
